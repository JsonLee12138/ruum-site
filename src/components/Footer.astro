---
import { LOCALES, getCopy, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  subpath?: string;
}

const { locale, subpath = '' } = Astro.props;
const copy = getCopy(locale);
---

<footer class="border-t border-hairline bg-surface">
  <div class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6">
    <div class="grid gap-8 md:grid-cols-[1.4fr_1fr]">
      <div class="space-y-3">
        <div class="flex items-center gap-2.5">
          <img src="/ruum.svg" alt="ruum mark" width="22" height="22" class="h-[22px] w-[22px] rounded-[3px]" />
          <span class="text-[14px] font-semibold tracking-tight text-ink">{copy.footer.etymologyTitle}</span>
        </div>
        <p class="max-w-[540px] text-[13px] leading-relaxed text-ink-secondary">
          {copy.footer.etymologyBody}
        </p>
        <p class="font-mono text-[11px] text-ink-muted">{copy.footer.license}</p>
      </div>

      <div class="flex flex-col justify-between gap-6 md:items-end">
        <div class="flex flex-wrap gap-x-5 gap-y-2 text-[13px] text-ink-secondary">
          <a href={localePath(locale, 'download')} class="no-underline text-inherit hover:text-ink transition-colors">
            {copy.footer.links.download}
          </a>
          <a href={localePath(locale, 'changelog')} class="no-underline text-inherit hover:text-ink transition-colors">
            {copy.footer.links.changelog}
          </a>
          <a
            href="https://github.com/JsonLee12138/Ruum"
            target="_blank"
            rel="noopener noreferrer"
            class="no-underline text-inherit hover:text-ink transition-colors"
          >
            {copy.footer.links.github}
          </a>
          <a
            href="https://github.com/JsonLee12138/Ruum/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="no-underline text-inherit hover:text-ink transition-colors"
          >
            {copy.footer.links.releases}
          </a>
          <a
            href="https://github.com/JsonLee12138/Ruum/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="no-underline text-inherit hover:text-ink transition-colors"
          >
            {copy.footer.links.issues}
          </a>
        </div>

        <div class="flex items-center gap-2">
          {
            LOCALES.map((loc) => {
              const locCopy = getCopy(loc);
              return (
                <a
                  href={localePath(loc, subpath)}
                  class:list={[
                    'rounded-[2px] border px-2 py-0.5 font-mono text-[11px] no-underline transition-colors',
                    loc === locale
                      ? 'border-strong bg-inset text-ink font-semibold'
                      : 'border-hairline bg-canvas text-ink-muted hover:text-ink',
                  ]}
                >
                  {locCopy.localeLabel}
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</footer>
